{
	"schemaVersion": 1,
	"id": "blockscanner",
	"version": "${version}",
	"name": "Blockscanner",
	"description": "This is a Minecraft mod that allows you to scan your surroundings for ore blocks.",
	"authors": [
		"Inferis"
	],
	"contact": {
		"homepage": "https://inferis.org/",
		"sources": "https://github.com/Inferis/blockscanner"
	},
	"license": "MIT",
	"icon": "assets/blockscanner/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"blockscanner.BlockScanner"
		],
		"client": [
			"blockscanner.client.BlockscannerClient"
		]
	},
	"mixins": [
		"blockscanner.mixins.json",
		{
			"config": "blockscanner.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}